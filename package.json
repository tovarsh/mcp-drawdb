{
  "name": "mcp-drawdb",
  "version": "0.3.1",
  "description": "MCP bridge for drawdb — connects Claude Code to drawdb in your browser via WebSocket relay",
  "author": "JKnight <dev@cns.red> (https://log.cns.red)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tovarsh/mcp-drawdb.git"
  },
  "homepage": "https://github.com/tovarsh/mcp-drawdb",
  "bugs": {
    "url": "https://github.com/tovarsh/mcp-drawdb/issues"
  },
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "mcp-drawdb": "./dist/index.js",
    "mcp-drawdb-relay": "./dist/relay.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
